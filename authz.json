{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/secret-sources",
      "body": {
        "name": "authz-own-source",
        "kind": "onepassword-connect",
        "baseUrl": "https://127.0.0.1:9",
        "token": "authz-token"
      },
      "capture": {
        "secret-sources.item": "source.id"
      }
    },
    {
      "as": "owner",
      "method": "POST",
      "path": "/plugin-api/secret-sources",
      "body": {
        "name": "authz-vault-source",
        "kind": "bitwarden-vault",
        "baseUrl": "https://127.0.0.1:9"
      },
      "capture": {
        "secret-sources.vault": "source.id"
      }
    }
  ],
  "routes": {
    "DELETE /plugin-api/secret-sources/:id": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.item"
      },
      "params": {
        "id": "secret-sources.item"
      },
      "destructive": true
    },
    "DELETE /plugin-api/secret-sources/:id/session": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.vault"
      },
      "params": {
        "id": "secret-sources.vault"
      }
    },
    "GET /plugin-api/secret-sources": {
      "access": "user",
      "permission": "credentials.view"
    },
    "GET /plugin-api/secret-sources/:id/items": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.item"
      },
      "params": {
        "id": "secret-sources.item"
      },
      "allowed": "any",
      "note": "Needs a reachable bw serve"
    },
    "GET /plugin-api/secret-sources/:id/session": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.vault"
      },
      "params": {
        "id": "secret-sources.vault"
      }
    },
    "POST /plugin-api/secret-sources": {
      "access": "user"
    },
    "POST /plugin-api/secret-sources/:id/session": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.vault"
      },
      "params": {
        "id": "secret-sources.vault"
      },
      "allowed": "any",
      "note": "An empty body is refused before any sign in"
    },
    "POST /plugin-api/secret-sources/:id/session/sso": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.vault"
      },
      "params": {
        "id": "secret-sources.vault"
      }
    },
    "POST /plugin-api/secret-sources/:id/test": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.item"
      },
      "params": {
        "id": "secret-sources.item"
      }
    },
    "POST /plugin-api/secret-sources/test-reference": {
      "access": "user"
    },
    "PUT /plugin-api/secret-sources/:id": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "secret-sources.item"
      },
      "params": {
        "id": "secret-sources.item"
      }
    }
  }
}
