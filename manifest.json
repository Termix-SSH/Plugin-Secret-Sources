{
  "id": "secret-sources",
  "name": "Secret Sources",
  "version": "1.0.0",
  "description": "Pull host passwords and keys from 1Password when you connect instead of storing them in Termix.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Secret-Sources",
  "docs": "https://docs.termix.site/plugins/secret-sources",
  "category": "Access & Security",
  "icon": "KeyRound",
  "features": [
    "Works with a self-hosted 1Password Connect server",
    "Use op://vault/item/field references in a host's password or key fields",
    "Secrets are fetched each time you connect and never stored in Termix"
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "db:own",
    "secrets:own",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ui:surface",
    "users:impersonate"
  ],
  "contributes": {
    "auth": {
      "secretSchemes": ["op"]
    },
    "settings": {
      "admin": [
        {
          "key": "privateEndpoints",
          "type": "textarea",
          "labelKey": "settings.admin.privateEndpoints.label",
          "descriptionKey": "settings.admin.privateEndpoints.description",
          "default": "localhost\n127.0.0.1\n::1\nhost.docker.internal"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
